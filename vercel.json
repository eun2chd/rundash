{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/guide", "destination": "/guide/index.html" },
    { "source": "/running", "destination": "/running/index.html" },
    { "source": "/running-crew", "destination": "/running-crew/index.html" },
    { "source": "/run-together", "destination": "/run-together/index.html" },
    { "source": "/running-shoes", "destination": "/running-shoes/index.html" },
    { "source": "/study", "destination": "/study/index.html" },
    { "source": "/study-group", "destination": "/study-group/index.html" },
    { "source": "/healing", "destination": "/healing/index.html" },
    { "source": "/pomodoro-timer", "destination": "/pomodoro-timer/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
